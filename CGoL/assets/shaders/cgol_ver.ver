#version 430 core

// Render vertex shader for the GPU Game of Life grid.
//
// binding 0 : current-generation grid (uint per cell, row-major)
// binding 1 : render config vec4(surfaceWidth, surfaceHeight, gridWidth, gridHeight)
//
// One vertex is emitted per grid cell. Alive cells produce a point sized like
// a cell; dead cells render fully transparent (alpha 0) so the pipeline can
// draw a constant number of vertices without knowing the live-cell count
// (no host readback needed to render).

layout(std430, binding = 0) readonly buffer Grid
{
    uint grid[];
};

layout(std430, binding = 1) readonly buffer GridConfig
{
    vec4 config;
};

layout(location = 0) out vec4 cellColor;

void main()
{
    uint id = gl_VertexID;

    if (id >= uint(config.z * config.w))
    {
        cellColor = vec4(1.0, 1.0, 1.0, 0.0);
        gl_Position = vec4(0.0, 0.0, 0.0, 1.0);
        gl_PointSize = 0.0;
        return;
    }

    if (grid[id] != 1u)
    {
        // Dead cell: hide it via a fully transparent color and zero size.
        cellColor = vec4(1.0, 1.0, 1.0, 0.0);
        gl_Position = vec4(0.0, 0.0, 0.0, 1.0);
        gl_PointSize = 0.0;
        return;
    }

    uint ux = id % uint(config.z);
    uint uy = id / uint(config.z);

    float cellWidth  = config.x / config.z;
    float cellHeight = config.y / config.w;

    // Cell centre in surface pixels, then normalised to NDC [-1, 1].
    vec2 worldPx = vec2(
        (float(ux) + 0.5) * cellWidth,
        (float(uy) + 0.5) * cellHeight
    );

    vec2 ndc = vec2(
    worldPx.x / config.x * 2.0 - 1.0,
    1.0 - worldPx.y / config.y * 2.0
    );

    gl_Position = vec4(ndc, 0.0, 1.0);

    gl_PointSize = max(1.0, min(cellWidth, cellHeight));
    
    cellColor = vec4(1.0, 1.0, 1.0, 1.0);
}