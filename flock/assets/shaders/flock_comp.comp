#version 430 core

layout(local_size_x = 256) in;

// ============================================================
// Buffers
// ============================================================

layout(std430, binding = 0) readonly buffer InputBoids
{
    vec4 inputStates[];
};

layout(std430, binding = 1) writeonly buffer OutputBoids
{
    vec4 outputStates[];
};

layout(std430, binding = 2) readonly buffer InputTeams
{
    uint inputTeams[];
};

layout(std430, binding = 3) writeonly buffer OutputTeams
{
    uint outputTeams[];
};

layout(std430, binding = 4) buffer CellCountsA
{
    uint cellCountsA[];
};

layout(std430, binding = 5) buffer CellCountsB
{
    uint cellCountsB[];
};

layout(std430, binding = 6) buffer CellStarts
{
    uint cellStart[];
};

layout(std430, binding = 7) buffer Benchmark
{
    // First half: per-boid candidate checks (pass 4).
    // Second half: per-boid neighbours used for steering (pass 4).
    uint benchmarkData[];
};


// ============================================================
// Uniforms
// ============================================================

uniform int pass;

uniform int particleCount;
uniform int maxNeighbours;

uniform int gridColumns;
uniform int gridRows;

uniform int benchmark;

uniform float dt;

uniform float worldWidth;
uniform float worldHeight;

uniform float maxSpeed;
uniform float maxForce;
uniform float initialSpeed;

uniform float perceptionRadius;
uniform float separationRadius;

uniform float cohesionRadius;
uniform float cohesionDeadZone;

uniform float separationWeight;
uniform float alignmentWeight;
uniform float cohesionWeight;


// ============================================================
// Constants
// ============================================================

const float EPSILON_SQUARED = 1e-6;
const int MAX_CANDIDATE_CHECKS = 5120; //Có lẽ nên chuyển đổi cơ chế duyệt chứ duyệt nhiều quá đành phải để limit vậy


// ============================================================
// Helpers
// ============================================================

vec2 limitVector(vec2 value, float maximum)
{
    float squared = dot(value, value);
    float maximumSquared = maximum * maximum;

    if (squared > maximumSquared)
    {
        value *= maximum * inversesqrt(squared);
    }

    return value;
}


ivec2 wrapCell(ivec2 cell)
{
    if (cell.x < 0)
        cell.x += gridColumns;
    else if (cell.x >= gridColumns)
        cell.x -= gridColumns;

    if (cell.y < 0)
        cell.y += gridRows;
    else if (cell.y >= gridRows)
        cell.y -= gridRows;

    return cell;
}


ivec2 cellOf(vec2 position)
{
    return ivec2(
        clamp(
            int(floor(position.x / perceptionRadius)),
            0,
            gridColumns - 1
        ),
        clamp(
            int(floor(position.y / perceptionRadius)),
            0,
            gridRows - 1
        )
    );
}


int cellIndex(ivec2 cell)
{
    return cell.y * gridColumns + cell.x;
}


vec2 toroidalDelta(
    vec2 from,
    vec2 to,
    vec2 halfWorld,
    vec2 world)
{
    vec2 delta = from - to;

    if (delta.x > halfWorld.x)
        delta.x -= world.x;
    else if (delta.x < -halfWorld.x)
        delta.x += world.x;

    if (delta.y > halfWorld.y)
        delta.y -= world.y;
    else if (delta.y < -halfWorld.y)
        delta.y += world.y;

    return delta;
}


// ============================================================
// PASS 0
//
// Clear both cell counters.
// ============================================================

void clearGrid(uint index)
{
    uint totalCells =
        uint(gridColumns * gridRows);

    if (index < totalCells)
    {
        cellCountsA[index] = 0u;
        cellCountsB[index] = 0u;
    }
}


// ============================================================
// PASS 1
//
// Count boids per cell.
//
// After this pass cellCountsA[c] holds the exact occupancy of
// cell c. No fixed-capacity bucket storage exists anymore.
// ============================================================

void buildGrid(uint index)
{
    if (index >= uint(particleCount))
        return;

    ivec2 cell =
        cellOf(inputStates[index].xy);

    atomicAdd(
        cellCountsA[uint(cellIndex(cell))],
        1u
    );

    // uint maxPerCell = 512;
    // uint old = atomicAdd(cellCountsA[uint(cellIndex(cell))], 1u);
    // if (old >= maxPerCell) {
    //     atomicAdd(cellCountsA[uint(cellIndex(cell))], -1u);
    //     return; // Bỏ qua con boid này trong lần đếm này (hoặc chuyển xử lý khác)
    // }
}


// ============================================================
// PASS 2
//
// Exclusive prefix sum of cell occupancies -> cellStart[].
//
//   cellStart[c]     = first sorted index belonging to cell c
//   cellStart[c + 1] = one-past-the-end of cell c
//
// The cell grid is small (Emper uses < 4096 cells), so a
// single-thread serial scan is effectively free and avoids the
// complexity and hazards of a shared-memory workgroup scan.
// Host-issued glMemoryBarrier() between dispatches makes the
// result visible to pass 3.
// ============================================================

void buildCellStart(uint index)
{
    if (index != 0u)
        return;

    uint totalCells =
        uint(gridColumns * gridRows);

    uint running = 0u;

    for (uint c = 0u; c < totalCells; ++c)
    {
        cellStart[c] = running;
        running += cellCountsA[c];
    }

    cellStart[totalCells] = running;
}


// ============================================================
// PASS 3
//
// Scatter boids into cell-contiguous order.
//
// Each boid computes its cell, claims a unique slot inside that
// cell with an atomic counter, then writes its state and team to
//   output[cellStart[cell] + slot].
//
// After this pass both the state buffer and the team buffer are
// perfectly sorted by cell. The neighbour traversal in pass 4
// can then read strictly sequential addresses (design "B":
// reordered state, no particleIndices[] indirection).
// ============================================================

void reorderBoids(uint index)
{
    if (index >= uint(particleCount))
        return;

    vec4 state =
        inputStates[index];

    uint team =
        inputTeams[index];

    ivec2 cell =
        cellOf(state.xy);

    uint cellId =
        uint(cellIndex(cell));

    uint slot =
        atomicAdd(
            cellCountsB[cellId],
            1u
        );

    uint dest =
        cellStart[cellId] + slot;

    outputStates[dest] =
        state;

    outputTeams[dest] =
        team;
}


// ============================================================
// PASS 4
//
// Flock + integrate.
//
// inputStates[] is the cell-contiguous buffer produced by
// pass 3, so all neighbour loads are sequential and cache
// friendly. No particleIndices[] indirection is needed.
// ============================================================

void updateBoid(uint index)
{
    if (index >= uint(particleCount))
        return;


    // --------------------------------------------------------
    // Current state
    // --------------------------------------------------------

    vec4 current =
        inputStates[index];

    vec2 position =
        current.xy;

    vec2 velocity =
        current.zw;

    uint team =
        inputTeams[index];


    // --------------------------------------------------------
    // Constants
    // --------------------------------------------------------

    vec2 world =
        vec2(
            worldWidth,
            worldHeight
        );

    vec2 halfWorld =
        world * 0.5;

    float perceptionSquared =
        perceptionRadius *
        perceptionRadius;

    float separationSquared =
        separationRadius *
        separationRadius;


    // --------------------------------------------------------
    // Accumulators
    // --------------------------------------------------------

    vec2 separationForce =
        vec2(0.0);

    vec2 alignment =
        vec2(0.0);

    vec2 cohesionForce =
        vec2(0.0);

    uint neighbourCount =
        0u;

    uint candidateChecks =
        0u;


    // --------------------------------------------------------
    // Spatial cell
    // --------------------------------------------------------

    ivec2 centerCell =
        cellOf(position);


    // --------------------------------------------------------
    // Search 3x3 neighbouring cells
    // --------------------------------------------------------

    bool reachedLimit =
        false;

    for (int offsetY = -1;
         offsetY <= 1 && !reachedLimit;
         ++offsetY)
    {
        for (int offsetX = -1;
             offsetX <= 1 && !reachedLimit;
             ++offsetX)
        {
            ivec2 cell =
                wrapCell(
                    centerCell +
                    ivec2(offsetX, offsetY)
                );

            uint cellId =
                uint(
                    cell.y * gridColumns +
                    cell.x
                );

            uint begin =
                cellStart[cellId];

            uint end =
                cellStart[cellId + 1u];


            // ------------------------------------------------
            // Scan contiguous cell range
            // ------------------------------------------------

            for (uint j = begin;
                 j < end;
                 ++j)
            {
                // Self appears exactly once in the center cell.
                if (j == index)
                    continue;


                ++candidateChecks;

                if (candidateChecks >= MAX_CANDIDATE_CHECKS)
                    break;

                // ------------------------------------------------
                // Load neighbour state.
                //
                // j is the *sorted index*: states are laid out
                // sequentially by cell, so threads iterating the
                // same cell read identical sequential ranges --
                // coalesced, cache-friendly access.
                // ------------------------------------------------

                vec4 neighbourState =
                    inputStates[j];


                vec2 delta =
                    toroidalDelta(
                        neighbourState.xy,
                        position,
                        halfWorld,
                        world
                    );

                float squared =
                    dot(delta, delta);


                // Outside perception radius.
                if (squared > perceptionSquared)
                    continue;


                // ------------------------------------------------
                // Separation
                //
                // Separation intentionally applies to every team.
                // ------------------------------------------------

                if (squared < separationSquared &&
                    squared > EPSILON_SQUARED)
                {
                    float invDistance =
                        inversesqrt(squared);

                    float strength =
                        (
                            separationRadius *
                            invDistance -
                            1.0
                        ) * invDistance;

                    separationForce -=
                        delta * strength;
                }


                // ------------------------------------------------
                // Team filter
                //
                // Only alignment/cohesion use same-team neighbours.
                // ------------------------------------------------

                if (inputTeams[j] != team)
                    continue;


                // ------------------------------------------------
                // Alignment
                // ------------------------------------------------

                alignment +=
                    neighbourState.zw;


                // ------------------------------------------------
                // Cohesion
                // ------------------------------------------------

                cohesionForce +=
                    delta;


                ++neighbourCount;


                // ------------------------------------------------
                // Hard neighbour limit
                // ------------------------------------------------

                if (maxNeighbours > 0 &&
                    neighbourCount >= uint(maxNeighbours))
                {
                    reachedLimit = true;
                    break;
                }
            }
        }
    }

    if (benchmark != 0)
    {
        benchmarkData[index] =
            candidateChecks;

        benchmarkData[uint(particleCount) + index] =
            neighbourCount;
    }


    // ========================================================
    // Separation
    // ========================================================

    separationForce =
        limitVector(
            separationForce,
            maxForce
        );


    // ========================================================
    // Alignment + Cohesion
    // ========================================================

    if (neighbourCount > 0u)
    {
        float count =
            float(neighbourCount);


        // ----------------------------------------------------
        // Alignment
        // ----------------------------------------------------

        alignment =
            alignment / count -
            velocity;

        alignment =
            limitVector(
                alignment,
                maxForce
            );


        // ----------------------------------------------------
        // Cohesion
        // ----------------------------------------------------

        cohesionForce /=
            count;

        float cohesionDistanceSquared =
            dot(
                cohesionForce,
                cohesionForce
            );

        float deadZoneSquared =
            cohesionDeadZone *
            cohesionDeadZone;

        if (cohesionDistanceSquared >
            deadZoneSquared)
        {
            float cohesionDistance =
                sqrt(
                    cohesionDistanceSquared
                );

            float normalizedDistance =
                min(
                    (
                        cohesionDistance -
                        cohesionDeadZone
                    ) / cohesionRadius,
                    1.0
                );

            vec2 desired =
                cohesionForce *
                (
                    maxSpeed *
                    normalizedDistance /
                    cohesionDistance
                );

            cohesionForce =
                limitVector(
                    desired - velocity,
                    maxForce
                );
        }
        else
        {
            cohesionForce =
                vec2(0.0);
        }
    }


    // ========================================================
    // Steering
    // ========================================================

    vec2 acceleration =
        separationForce * separationWeight +
        alignment       * alignmentWeight +
        cohesionForce   * cohesionWeight;

    acceleration =
        limitVector(
            acceleration,
            maxForce
        );


    // ========================================================
    // Velocity
    // ========================================================

    vec2 nextVelocity =
        velocity +
        acceleration * dt;


    float minimumSpeed =
        initialSpeed * 0.75;

    float speedSquared =
        dot(
            nextVelocity,
            nextVelocity
        );

    float minimumSpeedSquared =
        minimumSpeed *
        minimumSpeed;


    if (speedSquared < minimumSpeedSquared)
    {
        if (speedSquared > EPSILON_SQUARED)
        {
            nextVelocity *=
                minimumSpeed *
                inversesqrt(speedSquared);
        }
        else
        {
            float velocitySquared =
                dot(
                    velocity,
                    velocity
                );

            if (velocitySquared >
                EPSILON_SQUARED)
            {
                nextVelocity =
                    velocity *
                    (
                        minimumSpeed *
                        inversesqrt(
                            velocitySquared
                        )
                    );
            }
            else
            {
                nextVelocity =
                    vec2(
                        initialSpeed,
                        0.0
                    );
            }
        }
    }


    // --------------------------------------------------------
    // Maximum speed
    // --------------------------------------------------------

    nextVelocity =
        limitVector(
            nextVelocity,
            maxSpeed
        );


    // ========================================================
    // Position
    // ========================================================

    vec2 nextPosition =
        position +
        nextVelocity * dt;

    nextPosition =
        mod(
            nextPosition + world,
            world
        );


    // ========================================================
    // Output
    //
    // Pass 4 writes integrated results back into the persistent
    // buffer 0 at the *sorted* index. The team must be mirrored
    // back at the same index so the persistent team buffer stays
    // consistent with the persistent state buffer for rendering.
    // ========================================================

    outputStates[index] =
        vec4(
            nextPosition,
            nextVelocity
        );

    outputTeams[index] =
        team;
}


// ============================================================
// Entry
// ============================================================

void main()
{
    uint index =
        gl_GlobalInvocationID.x;
    if (pass == 0)
    {
        clearGrid(index);
    }
    else if (pass == 1)
    {
        buildGrid(index);
    }
    else if (pass == 2)
    {
        buildCellStart(index);
    }
    else if (pass == 3)
    {
        reorderBoids(index);
    }
    else if (pass == 4)
    {
        updateBoid(index);
    }
}